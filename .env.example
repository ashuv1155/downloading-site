# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & CORS
ALLOWED_ORIGINS=http://localhost:3000,https://saveamedia.pages.dev
MAX_REQUEST_BODY_BYTES=65536
REQUEST_TIMEOUT_SECONDS=10.0
RATE_LIMIT_PER_MINUTE=60

# Provider Configuration
# Options: "mock", "none", or a custom provider key
EXTRACTION_PROVIDER=mock
# PROVIDER_API_KEY=
# PROVIDER_API_URL=

